# ---------------------------------------------------------------------------
# Servidor (VPS). Copie para .env e ajuste antes do docker compose up.
# ---------------------------------------------------------------------------

# Dominio do Caddy — ele emite o certificado TLS sozinho.
# HTTPS nao e opcional: o navegador so libera WebRTC em contexto seguro.
JUNTO_DOMAIN=junto.seudominio.com

# Quantas pessoas cabem numa sala (host + espectadores).
MAX_PEERS_PER_ROOM=8

# Quanto tempo a sala sobrevive se o host cair, para ele voltar com o mesmo link.
HOST_GRACE_MS=60000

# STUN descobre seu IP publico; resolve a maioria das redes domesticas.
STUN_URLS=stun:stun.l.google.com:19302

# TURN e a rede de seguranca para NAT simetrico / CGNAT (internet movel e varios
# provedores brasileiros). Sem ele, essas pessoas simplesmente NAO conectam — o
# sintoma e "Conectando..." para sempre, sem erro nenhum. Aconteceu com um iPhone
# em 4G, e foi o que motivou este bloco.
#
# Opcao A (recomendada) — Cloudflare Realtime TURN: gerenciado, 1000 GB/mes
# gratis, nada para manter. Crie a chave em:
#   Cloudflare Dashboard -> Realtime -> TURN -> Create
# O servidor gera credenciais de curta duracao sozinho; o segredo nunca sai daqui.
# CF_TURN_KEY_ID=
# CF_TURN_API_TOKEN=
# CF_TURN_TTL_SECONDS=43200

# Opcao B — coturn proprio (infra/docker-compose.yml). So e lido quando a
# opcao A nao esta configurada.
# TURN_URLS=turn:junto.seudominio.com:3478
# Troque por algo aleatorio: openssl rand -hex 32
# TURN_SECRET=troque-este-segredo
# TURN_TTL_SECONDS=43200

# ---------------------------------------------------------------------------
# App host (Electron) — so precisa disso se voce NAO estiver em localhost.
# ---------------------------------------------------------------------------
# JUNTO_SIGNALING_URL=wss://junto.seudominio.com/ws
# JUNTO_WEB_URL=https://junto.seudominio.com
